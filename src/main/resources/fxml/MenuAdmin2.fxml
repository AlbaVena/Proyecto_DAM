<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.DatePicker?>

<BorderPane fx:id="PaneAdmin"
	stylesheets="@../styles/Styles.css" styleClass="fondo-principal"
	prefHeight="700.0" prefWidth="900.0"
	xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.alba.proyecto.controller.MenuAdminController">
	<padding>
		<Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
	</padding>

	<top>
		<HBox fx:id="hbBarraSuperior" styleClass="barra-superior"
			alignment="CENTER" fillHeight="false" prefHeight="98.0"
			prefWidth="900.0" BorderPane.alignment="CENTER">
			<children>
				<ImageView fitHeight="100.0" fitWidth="127.0"
					pickOnBounds="true" preserveRatio="true">
					<image>
						<Image url="@../images/LogoGestiona1_redondo.png" />
					</image>
				</ImageView>
				<Region prefHeight="150.0" prefWidth="350.0" />
				<VBox fx:id="vbUsuario" alignment="CENTER" prefHeight="150.0"
					prefWidth="216.0" spacing="5.0">
					<children>
						<Label fx:id="lblRol" text="Rol" styleClass="label-rol" />
						<Label fx:id="lblNombreUsuario" text="Nombre usuario"
							styleClass="label-nombre-usuario" />
					</children>
				</VBox>
				<Button fx:id="btnLogOut" mnemonicParsing="false"
					prefHeight="36.0" prefWidth="90.0" text="Cerrar sesión"
					styleClass="btn-logout">
					<HBox.margin>
						<Insets left="10.0" />
					</HBox.margin>
				</Button>
				<Button fx:id="btnAyuda" mnemonicParsing="false"
					onAction="#abrirAyuda" prefHeight="30.0" prefWidth="30.0" text="?"
					styleClass="btn-ayuda">
					<HBox.margin>
						<Insets left="10.0" />
					</HBox.margin>
				</Button>
			</children>
			<padding>
				<Insets left="20.0" right="10.0" />
			</padding>
		</HBox>
	</top>

	<left>
		<VBox styleClass="fondo-menu" prefWidth="190.0"
			BorderPane.alignment="CENTER">
			<children>
				<TitledPane styleClass="titled-pane-menu"
					expanded="false" text="Gestión de usuarios">
					<content>
						<VBox styleClass="fondo-menu" prefWidth="190.0" spacing="2.0">
							<children>
								<Button fx:id="btnNuevoUsuario" styleClass="btn-menu"
									maxWidth="1.7976931348623157E308" mnemonicParsing="false"
									onAction="#abrirCrearUsuario" text="Nuevo usuario" />
								<Button fx:id="btnModificarUsuario" styleClass="btn-menu"
									maxWidth="1.7976931348623157E308" mnemonicParsing="false"
									onAction="#abrirModificarUsuario" text="Modificar usuario" />
								<Button fx:id="btnConsultarUsuario" styleClass="btn-menu"
									maxWidth="1.7976931348623157E308" mnemonicParsing="false"
									onAction="#abrirConsultarUsuario" text="Consultar usuario" />
							</children>
						</VBox>
					</content>
				</TitledPane>
				<TitledPane styleClass="titled-pane-menu"
					expanded="false" text="Gestión de empresas">
					<content>
						<VBox styleClass="fondo-menu" prefWidth="190.0" spacing="2.0">
							<children>
								<Button fx:id="btnCrearEmpresaLateral"
									styleClass="btn-menu" maxWidth="1.7976931348623157E308"
									mnemonicParsing="false" onAction="#abrirCrearEmpresa"
									text="Nueva Empresa asociada" />
								<Button fx:id="btnModificarEmpresaLateral"
									styleClass="btn-menu" maxWidth="1.7976931348623157E308"
									mnemonicParsing="false" onAction="#abrirModificarEmpresa"
									text="Modificar datos de Empresa" />
								<Button fx:id="btnConsultarEmpresaLateral"
									styleClass="btn-menu" maxWidth="1.7976931348623157E308"
									mnemonicParsing="false" onAction="#abrirConsultarEmpresa"
									text="Consultar Empresa" />
							</children>
						</VBox>
					</content>
				</TitledPane>
				<TitledPane styleClass="titled-pane-menu"
					expanded="false" text="Gestión de FEs">
					<content>
						<VBox styleClass="fondo-menu" prefWidth="190.0" spacing="2.0">
							<children>
								<Button fx:id="btnNuevaFE" styleClass="btn-menu"
									maxWidth="1.7976931348623157E308" mnemonicParsing="false"
									onAction="#abrirNuevaFE" text="Nueva FE" />
								<Button fx:id="btnModificarFE" styleClass="btn-menu"
									maxWidth="1.7976931348623157E308" mnemonicParsing="false"
									onAction="#abrirModificarFE" text="Modificar FE" />
								<Button fx:id="btnConsultarFE" styleClass="btn-menu"
									maxWidth="1.7976931348623157E308" mnemonicParsing="false"
									onAction="#abrirConsultarFE" text="Consultar FE" />
							</children>
						</VBox>
					</content>
				</TitledPane>
				<TitledPane styleClass="titled-pane-menu"
					expanded="false" text="Documentación">
					<content>
						<VBox styleClass="fondo-menu" prefWidth="190.0" spacing="2.0">
							<children>
								<Button styleClass="btn-menu"
									maxWidth="1.7976931348623157E308" mnemonicParsing="false"
									onAction="#abrirFichaEstudiante" text="Ficha de estudiante" />
								<Button styleClass="btn-menu"
									maxWidth="1.7976931348623157E308" mnemonicParsing="false"
									onAction="#abrirInformeEstadistico" text="Informe estadístico" />
								<Button styleClass="btn-menu"
									maxWidth="1.7976931348623157E308" mnemonicParsing="false"
									onAction="#abrirListadoFEs" text="Listado de FEs" />
							</children>
						</VBox>
					</content>
				</TitledPane>
			</children>
		</VBox>
	</left>

	<center>
		<StackPane fx:id="stackPaneCentral"
			styleClass="fondo-principal" prefHeight="150.0" prefWidth="200.0"
			BorderPane.alignment="CENTER">
			<children>

				<!-- Panel principal / bienvenida -->
				<VBox fx:id="panelPrincipal" alignment="CENTER" spacing="30.0">
					<padding>
						<Insets top="40.0" left="40.0" right="40.0" bottom="40.0" />
					</padding>
					<children>
						<Label fx:id="lblBienvenidaAdmin" text="Bienvenido/a"
							style="-fx-font-size: 22px; -fx-font-weight: bold;" />
						<HBox alignment="CENTER" spacing="40.0">
							<children>
								<VBox alignment="CENTER" spacing="10.0"
									style="-fx-background-color: #D6EAF8; -fx-background-radius: 10; -fx-padding: 20;">
									<children>
										<Label fx:id="lblNumEstudiantes" text="0"
											style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #1A5276;" />
										<Label text="Estudiantes" style="-fx-font-size: 14px;" />
									</children>
								</VBox>
								<VBox alignment="CENTER" spacing="10.0"
									style="-fx-background-color: #D6EAF8; -fx-background-radius: 10; -fx-padding: 20;">
									<children>
										<Label fx:id="lblNumEmpresas" text="0"
											style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #1A5276;" />
										<Label text="Empresas" style="-fx-font-size: 14px;" />
									</children>
								</VBox>
								<VBox alignment="CENTER" spacing="10.0"
									style="-fx-background-color: #D6EAF8; -fx-background-radius: 10; -fx-padding: 20;">
									<children>
										<Label fx:id="lblNumFCTs" text="0"
											style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #1A5276;" />
										<Label text="FEs registradas"
											style="-fx-font-size: 14px;" />
									</children>
								</VBox>
							</children>
						</HBox>
					</children>
				</VBox>

				<!-- Panel crear empresa + tutor opcional -->
				<VBox fx:id="panelCrearEmpresa" managed="false" visible="false"
					spacing="15.0">
					<padding>
						<Insets top="20.0" left="30.0" right="30.0" bottom="20.0" />
					</padding>
					<children>

						<!-- Sección empresa -->
						<Label styleClass="titulo-panel" text="Nueva Empresa" />

						<GridPane hgap="15.0" vgap="14.0">
							<columnConstraints>
								<ColumnConstraints minWidth="120.0"
									prefWidth="130.0" halignment="RIGHT" />
								<ColumnConstraints minWidth="200.0"
									prefWidth="260.0" />
							</columnConstraints>
							<rowConstraints>
								<RowConstraints minHeight="36.0" />
								<RowConstraints minHeight="36.0" />
								<RowConstraints minHeight="36.0" />
							</rowConstraints>
							<children>
								<Label text="Nombre:" GridPane.columnIndex="0"
									GridPane.rowIndex="0" />
								<TextField fx:id="tfNombreEmpresa" prefWidth="260.0"
									GridPane.columnIndex="1" GridPane.rowIndex="0" />
								<Label text="Dirección:" GridPane.columnIndex="0"
									GridPane.rowIndex="1" />
								<TextField fx:id="tfDireccionEmpresa"
									prefWidth="260.0" GridPane.columnIndex="1"
									GridPane.rowIndex="1" />
								<Label text="Teléfono:" GridPane.columnIndex="0"
									GridPane.rowIndex="2" />
								<TextField fx:id="tfTelefonoEmpresa" prefWidth="260.0"
									GridPane.columnIndex="1" GridPane.rowIndex="2" />
							</children>
						</GridPane>

						<!-- Separador -->
						<Separator>
							<VBox.margin>
								<Insets top="5.0" bottom="5.0" />
							</VBox.margin>
						</Separator>

						<!-- Sección tutor opcional -->
						<Label text="Tutor de esta empresa (opcional)"
							style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #18406a;" />
						<Label
							text="Si ya conoces el tutor, puedes crearlo ahora. Si no, puedes añadirlo más adelante desde Gestión de usuarios."
							style="-fx-font-size: 11px; -fx-font-style: italic; -fx-text-fill: #666;"
							wrapText="true" />

						<GridPane hgap="10.0" vgap="14.0">
							<columnConstraints>
								<ColumnConstraints minWidth="90.0"
									prefWidth="100.0" halignment="RIGHT" />
								<ColumnConstraints minWidth="130.0"
									prefWidth="150.0" />
								<ColumnConstraints minWidth="90.0"
									prefWidth="100.0" halignment="RIGHT" />
								<ColumnConstraints minWidth="130.0"
									prefWidth="150.0" />
							</columnConstraints>
							<rowConstraints>
								<RowConstraints minHeight="36.0" />
								<RowConstraints minHeight="36.0" />
								<RowConstraints minHeight="36.0" />
							</rowConstraints>
							<children>
								<!-- Fila 0: Nombre y Apellidos -->
								<Label text="Nombre:" GridPane.columnIndex="0"
									GridPane.rowIndex="0" />
								<TextField fx:id="tfNombreTutor"
									GridPane.columnIndex="1" GridPane.rowIndex="0" />
								<Label text="Apellidos:" GridPane.columnIndex="2"
									GridPane.rowIndex="0" />
								<TextField fx:id="tfApellidosTutor"
									GridPane.columnIndex="3" GridPane.rowIndex="0" />

								<!-- Fila 1: Email y Teléfono -->
								<Label text="Email:" GridPane.columnIndex="0"
									GridPane.rowIndex="1" />
								<TextField fx:id="tfEmailTutor"
									GridPane.columnIndex="1" GridPane.rowIndex="1" />
								<Label text="Teléfono:" GridPane.columnIndex="2"
									GridPane.rowIndex="1" />
								<TextField fx:id="tfTelefonoTutor"
									GridPane.columnIndex="3" GridPane.rowIndex="1" />

								<!-- Fila 2: Usuario y Contraseña -->
								<Label text="Usuario:" GridPane.columnIndex="0"
									GridPane.rowIndex="2" />
								<TextField fx:id="tfUsuarioTutor"
									GridPane.columnIndex="1" GridPane.rowIndex="2" />
								<Label text="Contraseña:" GridPane.columnIndex="2"
									GridPane.rowIndex="2" />
								<TextField fx:id="tfPasswordTutor"
									GridPane.columnIndex="3" GridPane.rowIndex="2" />
							</children>
						</GridPane>

						<!-- Botón único que guarda empresa y tutor si procede -->
						<HBox>
							<VBox.margin>
								<Insets top="10.0" />
							</VBox.margin>
							<children>
								<Button fx:id="btnGuardarEmpresa"
									styleClass="btn-primario" mnemonicParsing="false"
									onAction="#guardarEmpresa" prefWidth="110.0" text="Guardar" />
							</children>
						</HBox>

					</children>
				</VBox>

				<!-- Panel tabla empresas -->
				<VBox fx:id="panelTablaEmpresas" managed="false"
					visible="false" spacing="10.0">
					<padding>
						<Insets top="20.0" left="30.0" right="30.0" bottom="20.0" />
					</padding>
					<children>
						<Label fx:id="lblTituloTablaEmpresas"
							styleClass="titulo-panel" text="Empresas" />
						<HBox spacing="15.0" alignment="CENTER_LEFT">
							<children>
								<Label text="Buscar:" />
								<TextField fx:id="tfBuscarEmpresa" prefWidth="220.0"
									promptText="Nombre o dirección..." />
							</children>
						</HBox>
						<TableView fx:id="tablaEmpresas" prefHeight="400.0"
							prefWidth="640.0">
							<columnResizePolicy>
								<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
							</columnResizePolicy>
							<columns>
								<TableColumn fx:id="colNombreEmpresa" text="Nombre" />
								<TableColumn fx:id="colTelefonoEmpresa"
									text="Teléfono" />
								<TableColumn fx:id="colDireccionEmpresa"
									text="Dirección" />
								<TableColumn fx:id="colInfoEmpresa" text="Tutores" />
							</columns>
						</TableView>
					</children>
				</VBox>

				<!-- Panel modificar/consultar empresa -->
				<VBox fx:id="panelFormModificar" managed="false"
					visible="false" spacing="14.0">
					<padding>
						<Insets top="20.0" left="30.0" right="30.0" bottom="20.0" />
					</padding>
					<children>
						<Label fx:id="lblTituloEmpresa" styleClass="titulo-panel"
							text="Empresa" />

						<GridPane hgap="15.0" vgap="14.0">
							<columnConstraints>
								<ColumnConstraints minWidth="120.0"
									prefWidth="130.0" halignment="RIGHT" />
								<ColumnConstraints minWidth="200.0"
									prefWidth="260.0" />
								<ColumnConstraints minWidth="36.0"
									prefWidth="36.0" />
							</columnConstraints>
							<rowConstraints>
								<RowConstraints minHeight="36.0" />
								<RowConstraints minHeight="36.0" />
								<RowConstraints minHeight="36.0" />
							</rowConstraints>
							<children>
								<Label text="Nombre:" GridPane.columnIndex="0"
									GridPane.rowIndex="0" />
								<TextField fx:id="tfFormNombreEmpresa"
									editable="false" prefWidth="260.0" GridPane.columnIndex="1"
									GridPane.rowIndex="0" />
								<Button fx:id="btnEditarNombreEmpresa"
									mnemonicParsing="false" GridPane.columnIndex="2"
									GridPane.rowIndex="0">
									<graphic>
										<ImageView fitHeight="16.0" fitWidth="16.0"
											pickOnBounds="true" preserveRatio="true">
											<image>
												<Image url="@../images/icono_editar.png" />
											</image>
										</ImageView>
									</graphic>
								</Button>

								<Label text="Dirección:" GridPane.columnIndex="0"
									GridPane.rowIndex="1" />
								<TextField fx:id="tfFormDireccionEmpresa"
									editable="false" prefWidth="260.0" GridPane.columnIndex="1"
									GridPane.rowIndex="1" />
								<Button fx:id="btnEditarDireccionEmpresa"
									mnemonicParsing="false" GridPane.columnIndex="2"
									GridPane.rowIndex="1">
									<graphic>
										<ImageView fitHeight="16.0" fitWidth="16.0"
											pickOnBounds="true" preserveRatio="true">
											<image>
												<Image url="@../images/icono_editar.png" />
											</image>
										</ImageView>
									</graphic>
								</Button>

								<Label text="Teléfono:" GridPane.columnIndex="0"
									GridPane.rowIndex="2" />
								<TextField fx:id="tfFormTelefonoEmpresa"
									editable="false" prefWidth="260.0" GridPane.columnIndex="1"
									GridPane.rowIndex="2" />
								<Button fx:id="btnEditarTelefonoEmpresa"
									mnemonicParsing="false" GridPane.columnIndex="2"
									GridPane.rowIndex="2">
									<graphic>
										<ImageView fitHeight="16.0" fitWidth="16.0"
											pickOnBounds="true" preserveRatio="true">
											<image>
												<Image url="@../images/icono_editar.png" />
											</image>
										</ImageView>
									</graphic>
								</Button>
							</children>
						</GridPane>

						<HBox spacing="15.0">
							<VBox.margin>
								<Insets top="10.0" />
							</VBox.margin>
							<children>
								<Button fx:id="btnVolverTablaEmpresa"
									styleClass="btn-volver" mnemonicParsing="false"
									onAction="#volverTablaEmpresa" prefWidth="80.0" text="Volver" />
								<Button fx:id="btnCancelarFormEmpresa"
									styleClass="btn-peligro" mnemonicParsing="false"
									onAction="#cancelarFormEmpresa" prefWidth="80.0"
									text="Cancelar" />
								<Button fx:id="btnGuardarFormEmpresa"
									styleClass="btn-primario" mnemonicParsing="false"
									onAction="#guardarFormEmpresa" prefWidth="80.0" text="Guardar" />
							</children>
						</HBox>
					</children>
				</VBox>

				<!-- Panel crear usuario -->
				<VBox fx:id="panelCrearUsuario" managed="false" visible="false"
					spacing="15.0">
					<padding>
						<Insets top="20.0" left="30.0" right="30.0" bottom="20.0" />
					</padding>
					<children>
						<Label styleClass="titulo-panel" text="Nuevo usuario" />

						<GridPane hgap="20.0" vgap="12.0">
							<columnConstraints>
								<ColumnConstraints minWidth="110.0"
									prefWidth="120.0" halignment="RIGHT" />
								<ColumnConstraints minWidth="160.0"
									prefWidth="180.0" />
								<ColumnConstraints minWidth="110.0"
									prefWidth="120.0" halignment="RIGHT" />
								<ColumnConstraints minWidth="160.0"
									prefWidth="180.0" />
							</columnConstraints>
							<rowConstraints>
								<RowConstraints minHeight="34.0" />
								<RowConstraints minHeight="34.0" />
								<RowConstraints minHeight="34.0" />
								<RowConstraints minHeight="34.0" />
								<RowConstraints minHeight="34.0" />
								<RowConstraints minHeight="34.0" />
							</rowConstraints>
							<children>
								<!-- Fila 0: Rol y Empresa -->
								<Label text="Rol:" GridPane.columnIndex="0"
									GridPane.rowIndex="0" />
								<ComboBox fx:id="cbRol" prefWidth="180.0"
									promptText="Seleccionar..." GridPane.columnIndex="1"
									GridPane.rowIndex="0" />
								<Label text="Empresa:" GridPane.columnIndex="2"
									GridPane.rowIndex="0" />
								<ComboBox fx:id="cbEmpresaUsuario" prefWidth="180.0"
									GridPane.columnIndex="3" GridPane.rowIndex="0" />

								<!-- Fila 1: Nombre y Nº SS -->
								<Label text="Nombre:" GridPane.columnIndex="0"
									GridPane.rowIndex="1" />
								<TextField fx:id="tfNombre" promptText="Nombre"
									GridPane.columnIndex="1" GridPane.rowIndex="1" />
								<Label text="Nº S.S.:" GridPane.columnIndex="2"
									GridPane.rowIndex="1" />
								<TextField fx:id="tfNss" editable="false"
									promptText="XX-XXXXXX-XXX" GridPane.columnIndex="3"
									GridPane.rowIndex="1" />

								<!-- Fila 2: Apellidos y Email -->
								<Label text="Apellidos:" GridPane.columnIndex="0"
									GridPane.rowIndex="2" />
								<TextField fx:id="tfApellidosUsuario"
									promptText="Apellidos" GridPane.columnIndex="1"
									GridPane.rowIndex="2" />
								<Label text="Email:" GridPane.columnIndex="2"
									GridPane.rowIndex="2" />
								<TextField fx:id="tfEmailUsuario"
									promptText="correo@email.com" GridPane.columnIndex="3"
									GridPane.rowIndex="2" />

								<!-- Fila 3: Curso y Teléfono -->
								<Label text="Curso:" GridPane.columnIndex="0"
									GridPane.rowIndex="3" />
								<ComboBox fx:id="cbCurso" prefWidth="180.0"
									promptText="Seleccionar..." GridPane.columnIndex="1"
									GridPane.rowIndex="3" />
								<Label text="Teléfono:" GridPane.columnIndex="2"
									GridPane.rowIndex="3" />
								<TextField fx:id="tfTelefonoUsuario"
									promptText="6XX XXX XXX" GridPane.columnIndex="3"
									GridPane.rowIndex="3" />

								<!-- Fila 4: Nombre usuario -->
								<Label text="Usuario:" GridPane.columnIndex="0"
									GridPane.rowIndex="4" />
								<TextField fx:id="tfNombreUsuario"
									GridPane.columnIndex="1" GridPane.rowIndex="4" />
								<Label text="(máx. 25 car., letras/números/_)"
									style="-fx-font-style: italic; -fx-font-size: 11px;"
									GridPane.columnIndex="2" GridPane.columnSpan="2"
									GridPane.rowIndex="4" />

								<!-- Fila 5: Contraseña -->
								<Label text="Contraseña:" GridPane.columnIndex="0"
									GridPane.rowIndex="5" />
								<TextField fx:id="tfPass" GridPane.columnIndex="1"
