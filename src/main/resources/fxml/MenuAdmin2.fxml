								<Label fx:id="lblCursoFEConsulta" text="—"
									GridPane.columnIndex="3" GridPane.rowIndex="0" />

								<Label text="Email alumno/a:"
									style="-fx-font-weight: bold;" GridPane.columnIndex="0"
									GridPane.rowIndex="1" />
								<Label fx:id="lblEmailAlumnoFEConsulta" text="—"
									GridPane.columnIndex="1" GridPane.rowIndex="1" />
								<Label text="Periodo:" style="-fx-font-weight: bold;"
									GridPane.columnIndex="2" GridPane.rowIndex="1" />
								<Label fx:id="lblPeriodoFEConsulta" text="—"
									GridPane.columnIndex="3" GridPane.rowIndex="1" />

								<Label text="Fecha inicio:" style="-fx-font-weight: bold;"
									GridPane.columnIndex="0" GridPane.rowIndex="2" />
								<Label fx:id="lblFechaInicioFEConsulta" text="—"
									GridPane.columnIndex="1" GridPane.rowIndex="2" />
								<Label text="Fecha fin:" style="-fx-font-weight: bold;"
									GridPane.columnIndex="2" GridPane.rowIndex="2" />
								<Label fx:id="lblFechaFinFEConsulta" text="—"
									GridPane.columnIndex="3" GridPane.rowIndex="2" />

								<Label text="Tutor empresa:"
									style="-fx-font-weight: bold;" GridPane.columnIndex="0"
									GridPane.rowIndex="3" />
								<Label fx:id="lblTutorFEConsulta" text="—"
									GridPane.columnIndex="1" GridPane.rowIndex="3" />
								<Label text="Empresa:" style="-fx-font-weight: bold;"
									GridPane.columnIndex="2" GridPane.rowIndex="3" />
								<Label fx:id="lblEmpresaFEConsulta" text="—"
									GridPane.columnIndex="3" GridPane.rowIndex="3" />
							</children>
						</GridPane>
					</children>
				</VBox>

				<!-- Panel modificar FE (doble click en tabla) -->
				<VBox fx:id="panelModFE" managed="false" visible="false"
					spacing="14.0">
					<padding>
						<Insets top="20.0" left="30.0" right="30.0" bottom="20.0" />
					</padding>
					<children>
						<Label styleClass="titulo-panel" text="FE seleccionada" />

						<GridPane hgap="15.0" vgap="14.0">
							<columnConstraints>
								<ColumnConstraints minWidth="120.0"
									prefWidth="130.0" halignment="RIGHT" />
								<ColumnConstraints minWidth="200.0"
									prefWidth="260.0" />
								<ColumnConstraints minWidth="36.0"
									prefWidth="36.0" />
							</columnConstraints>
							<rowConstraints>
								<RowConstraints minHeight="36.0" />
								<RowConstraints minHeight="36.0" />
								<RowConstraints minHeight="36.0" />
								<RowConstraints minHeight="36.0" />
								<RowConstraints minHeight="36.0" />
							</rowConstraints>
							<children>
								<!-- Estudiante — solo lectura siempre -->
								<Label text="Estudiante:" GridPane.columnIndex="0"
									GridPane.rowIndex="0" />
								<TextField fx:id="tfEstudianteModFE" editable="false"
									prefWidth="260.0" GridPane.columnIndex="1"
									GridPane.rowIndex="0" />

								<!-- Periodo — solo lectura siempre -->
								<Label text="Periodo:" GridPane.columnIndex="0"
									GridPane.rowIndex="1" />
								<TextField fx:id="tfPeriodoModFE" editable="false"
									prefWidth="260.0" GridPane.columnIndex="1"
									GridPane.rowIndex="1" />

								<!-- Tutor — editable -->
								<Label text="Tutor empresa:" GridPane.columnIndex="0"
									GridPane.rowIndex="2" />
								<ComboBox fx:id="cbTutorModFE" disable="true"
									prefWidth="260.0" GridPane.columnIndex="1"
									GridPane.rowIndex="2" />
								<Button fx:id="btnEditarTutorModFE"
									mnemonicParsing="false" GridPane.columnIndex="2"
									GridPane.rowIndex="2">
									<graphic>
										<ImageView fitHeight="16.0" fitWidth="16.0"
											pickOnBounds="true" preserveRatio="true">
											<image>
												<Image url="@../images/icono_editar.png" />
											</image>
										</ImageView>
									</graphic>
								</Button>

								<!-- Fecha inicio — editable -->
								<Label text="Fecha inicio:" GridPane.columnIndex="0"
									GridPane.rowIndex="3" />
								<DatePicker fx:id="dpFechaInicioModFE" disable="true"
									prefWidth="260.0" GridPane.columnIndex="1"
									GridPane.rowIndex="3" />
								<Button fx:id="btnEditarFechaInicioModFE"
									mnemonicParsing="false" GridPane.columnIndex="2"
									GridPane.rowIndex="3">
									<graphic>
										<ImageView fitHeight="16.0" fitWidth="16.0"
											pickOnBounds="true" preserveRatio="true">
											<image>
												<Image url="@../images/icono_editar.png" />
											</image>
										</ImageView>
									</graphic>
								</Button>

								<!-- Fecha fin — editable -->
								<Label text="Fecha fin:" GridPane.columnIndex="0"
									GridPane.rowIndex="4" />
								<DatePicker fx:id="dpFechaFinModFE" disable="true"
									prefWidth="260.0" GridPane.columnIndex="1"
									GridPane.rowIndex="4" />
								<Button fx:id="btnEditarFechaFinModFE"
									mnemonicParsing="false" GridPane.columnIndex="2"
									GridPane.rowIndex="4">
									<graphic>
										<ImageView fitHeight="16.0" fitWidth="16.0"
											pickOnBounds="true" preserveRatio="true">
											<image>
												<Image url="@../images/icono_editar.png" />
											</image>
										</ImageView>
									</graphic>
								</Button>
							</children>
						</GridPane>

						<HBox spacing="15.0">
							<VBox.margin>
								<Insets top="10.0" />
							</VBox.margin>
							<children>
								<Button fx:id="btnVolverTablaFEs" styleClass="btn-volver"
									mnemonicParsing="false" onAction="#volverTablaFEs"
									prefWidth="80.0" text="Volver" />
								<Button fx:id="btnCancelarModFE" styleClass="btn-peligro"
									mnemonicParsing="false" onAction="#cancelarModFE"
									prefWidth="80.0" text="Cancelar" />
								<Button fx:id="btnGuardarModFE" styleClass="btn-primario"
									mnemonicParsing="false" onAction="#guardarModFE"
									prefWidth="80.0" text="Guardar" />
							</children>
						</HBox>
					</children>
				</VBox>
				<!-- Panel ficha de estudiante -->
				<VBox fx:id="panelFichaEstudiante" managed="false"
					visible="false" spacing="20.0">
					<padding>
						<Insets top="20.0" left="30.0" right="30.0" bottom="20.0" />
					</padding>
					<children>
						<Label styleClass="titulo-panel" text="Ficha de estudiante" />
						<Label
							text="Genera un PDF con los datos personales y de FE del estudiante seleccionado."
							wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #444;" />
						<Separator />
						<HBox spacing="15.0" alignment="CENTER_LEFT">
							<children>
								<Label text="Estudiante:" style="-fx-font-weight: bold;" />
								<ComboBox fx:id="cbEstudianteFicha" prefWidth="280.0"
									promptText="Seleccionar estudiante..." />
							</children>
						</HBox>
						<Label
							text="El informe incluirá: nombre, curso, empresa asignada, tutor, fechas de la FE y periodo."
							wrapText="true"
							style="-fx-font-size: 11px; -fx-font-style: italic; -fx-text-fill: #666;" />
						<HBox spacing="15.0">
							<VBox.margin>
								<Insets top="10.0" />
							</VBox.margin>
							<children>
								<Button fx:id="btnGenerarFicha" styleClass="btn-primario"
									mnemonicParsing="false" onAction="#generarFichaEstudiante"
									prefWidth="150.0" text="Generar PDF" />
							</children>
						</HBox>
					</children>
				</VBox>

				<!-- Panel informe estadístico -->
				<VBox fx:id="panelInformeEstadistico" managed="false"
					visible="false" spacing="20.0">
					<padding>
						<Insets top="20.0" left="30.0" right="30.0" bottom="20.0" />
					</padding>
					<children>
						<Label styleClass="titulo-panel" text="Informe estadístico" />
						<Label
							text="Genera un PDF con un resumen del estado actual del departamento."
							wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #444;" />
						<Separator />
						<VBox spacing="12.0"
							style="-fx-background-color: #D6EAF8; -fx-background-radius: 8; -fx-padding: 16;">
							<children>
								<Label text="El informe incluirá:"
									style="-fx-font-weight: bold; -fx-font-size: 13px;" />
								<Label text="• Número total de estudiantes registrados" />
								<Label text="• Número total de empresas colaboradoras" />
								<Label text="• Número total de FEs registradas" />
								<Label text="• Fecha de generación del informe" />
							</children>
						</VBox>
						<HBox spacing="15.0">
							<VBox.margin>
								<Insets top="10.0" />
							</VBox.margin>
							<children>
								<Button styleClass="btn-primario" mnemonicParsing="false"
									onAction="#generarInformeEstadistico" prefWidth="150.0"
									text="Generar PDF" />
							</children>
						</HBox>
					</children>
				</VBox>

				<!-- Panel listado de FEs -->
				<VBox fx:id="panelListadoFEs" managed="false" visible="false"
					spacing="20.0">
					<padding>
						<Insets top="20.0" left="30.0" right="30.0" bottom="20.0" />
					</padding>
					<children>
						<Label styleClass="titulo-panel" text="Listado de FEs" />
						<Label
							text="Genera un PDF con el listado completo de las FEs registradas en el sistema."
							wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #444;" />
						<Separator />
						<VBox spacing="12.0"
							style="-fx-background-color: #D6EAF8; -fx-background-radius: 8; -fx-padding: 16;">
							<children>
								<Label text="El informe incluirá:"
									style="-fx-font-weight: bold; -fx-font-size: 13px;" />
								<Label text="• Nombre del estudiante" />
								<Label text="• Empresa y tutor asignados" />
								<Label text="• Periodo, fecha de inicio y fecha de fin" />
							</children>
						</VBox>
						<HBox spacing="15.0">
							<VBox.margin>
								<Insets top="10.0" />
							</VBox.margin>
							<children>
								<Button styleClass="btn-primario" mnemonicParsing="false"
									onAction="#generarListadoFEs" prefWidth="150.0"
									text="Generar PDF" />
							</children>
						</HBox>
					</children>
				</VBox>

			</children>
		</StackPane>
	</center>

	<opaqueInsets>
		<Insets />
	</opaqueInsets>
	<padding>
		<Insets bottom="20.0" left="10.0" right="10.0" top="10.0" />
	</padding>

</BorderPane>
