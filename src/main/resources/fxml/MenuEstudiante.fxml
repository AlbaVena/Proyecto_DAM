<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<BorderPane fx:id="panelEstudiante" prefHeight="700.0"
	prefWidth="900.0" styleClass="fondo-principal"
	stylesheets="@../styles/Styles.css" xmlns="http://javafx.com/javafx/25"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.alba.proyecto.controller.MenuEstudianteController">
	<padding>
		<Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
	</padding>

	<top>
		<HBox fx:id="hbBarraSuperior" alignment="CENTER"
			fillHeight="false" prefHeight="98.0" prefWidth="900.0"
			styleClass="barra-superior" BorderPane.alignment="CENTER">
			<children>
				<ImageView fitHeight="100.0" fitWidth="127.0"
					pickOnBounds="true" preserveRatio="true">
					<image>
						<Image url="@../images/LogoGestiona1_redondo.png" />
					</image>
				</ImageView>
				<Region prefHeight="150.0" prefWidth="350.0" />
				<VBox fx:id="vbUsuario" alignment="CENTER" prefHeight="150.0"
					prefWidth="216.0" spacing="5.0">
					<children>
						<Label fx:id="lblRol" styleClass="label-rol" text="Rol" />
						<Label fx:id="lblNombreUsuario"
							styleClass="label-nombre-usuario" text="Nombre usuario" />
					</children>
				</VBox>
				<Button fx:id="btnLogOut" mnemonicParsing="false"
					prefHeight="36.0" prefWidth="110.0" styleClass="btn-logout"
					text="Cerrar sesión">
					<HBox.margin>
						<Insets left="10.0" />
					</HBox.margin>
				</Button>
				<Button fx:id="btnAyuda" mnemonicParsing="false"
					onAction="#abrirAyuda" prefHeight="30.0" prefWidth="30.0"
					styleClass="btn-ayuda" text="?">
					<HBox.margin>
						<Insets left="10.0" />
					</HBox.margin>
				</Button>
			</children>
			<padding>
				<Insets left="20.0" right="10.0" />
			</padding>
			<BorderPane.margin>
				<Insets left="10.0" />
			</BorderPane.margin>
		</HBox>
	</top>

	<left>
		<VBox prefWidth="190.0" spacing="2.0" styleClass="fondo-menu"
			BorderPane.alignment="CENTER">
			<children>
				<Button fx:id="btnMisDatos" maxWidth="1.7976931348623157E308"
					mnemonicParsing="false" onAction="#abrirMisDatos"
					styleClass="btn-menu" text="Mis datos" />
				<Button fx:id="btnMiFCT" maxWidth="1.7976931348623157E308"
					mnemonicParsing="false" onAction="#abrirMiFCT"
					styleClass="btn-menu" text="Mis FCTs" />
				<Button fx:id="btnAsistencia"
					maxWidth="1.7976931348623157E308" mnemonicParsing="false"
					onAction="#abrirAsistencia" styleClass="btn-menu" text="Asistencia" />
				<Button fx:id="btnDocumentacion"
					maxWidth="1.7976931348623157E308" mnemonicParsing="false"
					onAction="#abrirDocumentacion" styleClass="btn-menu"
					text="Documentación" />
			</children>
		</VBox>
	</left>

	<center>
		<StackPane prefHeight="150.0" prefWidth="200.0"
			styleClass="fondo-principal" BorderPane.alignment="CENTER">
			<children>
				<VBox fx:id="panelMisDatos" managed="false" prefHeight="600.0"
					prefWidth="700.0" spacing="15.0" visible="false">
					<padding>
						<Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
					</padding>
					<children>
						<Label styleClass="titulo-panel" text="Mis Datos" />
						<GridPane hgap="10.0" vgap="10.0">
							<columnConstraints>
								<ColumnConstraints minWidth="150.0"
									prefWidth="150.0" />
								<ColumnConstraints minWidth="250.0"
									prefWidth="250.0" />
								<ColumnConstraints minWidth="40.0"
									prefWidth="40.0" />
							</columnConstraints>
							<rowConstraints>
								<RowConstraints />
								<RowConstraints />
								<RowConstraints />
								<RowConstraints />
								<RowConstraints />
								<RowConstraints />
								<RowConstraints />
								<RowConstraints />
							</rowConstraints>
							<children>
								<Label text="Nombre" GridPane.columnIndex="0"
									GridPane.rowIndex="0" />
								<TextField fx:id="tfNombre" disable="true"
									GridPane.columnIndex="1" GridPane.rowIndex="0" />

								<Label text="Apellidos" GridPane.columnIndex="0"
									GridPane.rowIndex="1" />
								<TextField fx:id="tfApellidos" disable="true"
									GridPane.columnIndex="1" GridPane.rowIndex="1" />

								<Label text="Email" GridPane.columnIndex="0"
									GridPane.rowIndex="2" />
								<TextField fx:id="tfEmail" disable="true"
									GridPane.columnIndex="1" GridPane.rowIndex="2" />
								<Button fx:id="btnEditarEmail" mnemonicParsing="false"
									onAction="#editarEmail" GridPane.columnIndex="2"
									GridPane.rowIndex="2">
									<graphic>
										<ImageView fitHeight="16.0" fitWidth="16.0"
											pickOnBounds="true" preserveRatio="true">
											<image>
												<Image url="@../images/icono_editar.png" />
											</image>
										</ImageView>
									</graphic>
								</Button>

								<Label text="Teléfono" GridPane.columnIndex="0"
									GridPane.rowIndex="3" />
								<TextField fx:id="tfTelefono" disable="true"
									GridPane.columnIndex="1" GridPane.rowIndex="3" />
								<Button fx:id="btnEditarTelefono" mnemonicParsing="false"
									onAction="#editarTelefono" GridPane.columnIndex="2"
									GridPane.rowIndex="3">
									<graphic>
										<ImageView fitHeight="16.0" fitWidth="16.0"
											pickOnBounds="true" preserveRatio="true">
											<image>
												<Image url="@../images/icono_editar.png" />
											</image>
										</ImageView>
									</graphic>
								</Button>

								<Label text="Nº SS" GridPane.columnIndex="0"
									GridPane.rowIndex="4" />
								<TextField fx:id="tfNSS" disable="true"
									GridPane.columnIndex="1" GridPane.rowIndex="4" />

								<Label text="Curso" GridPane.columnIndex="0"
									GridPane.rowIndex="5" />
								<TextField fx:id="tfCurso" disable="true"
									GridPane.columnIndex="1" GridPane.rowIndex="5" />

								<Label text="Usuario" GridPane.columnIndex="0"
									GridPane.rowIndex="6" />
								<TextField fx:id="tfUsuario" disable="true"
									GridPane.columnIndex="1" GridPane.rowIndex="6" />

								<Label text="Contraseña" GridPane.columnIndex="0"
									GridPane.rowIndex="7" />
								<TextField fx:id="tfContrasena" disable="true"
									text="••••••••" GridPane.columnIndex="1" GridPane.rowIndex="7" />
							</children>
						</GridPane>
						<HBox alignment="CENTER_RIGHT">
							<children>
								<Button fx:id="btnGuardar" disable="true"
									mnemonicParsing="false" styleClass="btn-primario"
									text="Guardar" />
							</children>
						</HBox>
					</children>
				</VBox>

				<VBox fx:id="panelMisFCT" managed="false" prefHeight="600.0"
					prefWidth="700.0" spacing="15.0" visible="false">
					<padding>
						<Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
					</padding>
					<children>

						<!-- Título -->
						<Label styleClass="titulo-panel" text="Mis FCT" />

						<!-- Grid de información -->
						<GridPane hgap="15.0" vgap="10.0">
							<columnConstraints>
								<ColumnConstraints minWidth="120.0"
									prefWidth="130.0" />
								<ColumnConstraints minWidth="150.0"
									prefWidth="170.0" />
								<ColumnConstraints minWidth="100.0"
									prefWidth="120.0" />
								<ColumnConstraints minWidth="150.0"
									prefWidth="170.0" />
							</columnConstraints>
							<rowConstraints>
								<RowConstraints minHeight="30.0" />
								<RowConstraints minHeight="30.0" />
								<RowConstraints minHeight="30.0" />
								<RowConstraints minHeight="30.0" />
							</rowConstraints>
							<children>
								<!-- Fila 0 -->
								<Label text="Estudiante:" style="-fx-font-weight: bold;"
									GridPane.columnIndex="0" GridPane.rowIndex="0" />
								<Label fx:id="lblNombreEstudiante" text="-"
									GridPane.columnIndex="1" GridPane.rowIndex="0" />
								<Label text="Curso:" style="-fx-font-weight: bold;"
									GridPane.columnIndex="2" GridPane.rowIndex="0" />
								<Label fx:id="lblCursoEstudiante" text="-"
									GridPane.columnIndex="3" GridPane.rowIndex="0" />

								<!-- Fila 1 -->
								<Label text="Empresa:" style="-fx-font-weight: bold;"
									GridPane.columnIndex="0" GridPane.rowIndex="1" />
								<Label fx:id="lblNombreEmpresa" text="-"
									GridPane.columnIndex="1" GridPane.rowIndex="1" />
								<Label text="Dirección:" style="-fx-font-weight: bold;"
									GridPane.columnIndex="2" GridPane.rowIndex="1" />
								<Label fx:id="lblDireccionEmpresa" text="-"
									GridPane.columnIndex="3" GridPane.rowIndex="1" />

								<!-- Fila 2 -->
								<Label text="Tutor Empresa:"
									style="-fx-font-weight: bold;" GridPane.columnIndex="0"
									GridPane.rowIndex="2" />
								<Label fx:id="lblNombreTutor" text="-"
									GridPane.columnIndex="1" GridPane.rowIndex="2" />
								<Label text="Email:" style="-fx-font-weight: bold;"
									GridPane.columnIndex="2" GridPane.rowIndex="2" />
								<Label fx:id="lblEmailTutor" text="-"
									GridPane.columnIndex="3" GridPane.rowIndex="2" />

								<!-- Fila 3 -->
								<Label text="Inicio prácticas:"
									style="-fx-font-weight: bold;" GridPane.columnIndex="0"
									GridPane.rowIndex="3" />
								<Label fx:id="lblFechaInicio" text="-"
									GridPane.columnIndex="1" GridPane.rowIndex="3" />
								<Label text="Fin prácticas:"
									style="-fx-font-weight: bold;" GridPane.columnIndex="2"
									GridPane.rowIndex="3" />
								<Label fx:id="lblFechaFin" text="-"
									GridPane.columnIndex="3" GridPane.rowIndex="3" />
							</children>
						</GridPane>

						<!-- Separador -->
						<Separator />

						<!-- Título documentación -->
						<Label text="Documentación Asociada"
							style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #18406a;" />

						<!-- Tabla documentación -->
						<TableView fx:id="tablaDocumentos" prefHeight="200.0"
							prefWidth="640.0">
							<columnResizePolicy>
								<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
							</columnResizePolicy>
							<columns>
								<TableColumn fx:id="colNombreDoc" text="Nombre" />
								<TableColumn fx:id="colTipoDoc" text="Tipo" />
								<TableColumn fx:id="colModificadoDoc"
									text="Modificado" />
							</columns>
						</TableView>

					</children>
				</VBox>

				<VBox fx:id="panelAsistencia" managed="false"
					prefHeight="600.0" prefWidth="700.0" spacing="15.0" visible="false">
					<padding>
						<Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
					</padding>
					<children>
						<Label styleClass="titulo-panel" text="Asistencia" />
						<VBox fx:id="contenedorCalendario" prefHeight="400.0"
							prefWidth="650.0" />
						<HBox alignment="CENTER_LEFT" spacing="10.0">
							<children>
								<Label
									text="Faltas de asistencia pendientes de justificar:" />
								<Label fx:id="lblFaltasPendientes"
									style="-fx-font-weight: bold;" text="0" />
							</children>
						</HBox>
						<HBox alignment="CENTER_LEFT">
							<children>
								<Button fx:id="btnAdjuntarJustificante"
									mnemonicParsing="false" styleClass="btn-primario"
									text="Adjuntar justificante" />
							</children>
						</HBox>
					</children>
				</VBox>

				<VBox fx:id="panelDocumentacion" managed="false"
					prefHeight="200.0" prefWidth="100.0" visible="false" />
			</children>
		</StackPane>
	</center>

</BorderPane>
