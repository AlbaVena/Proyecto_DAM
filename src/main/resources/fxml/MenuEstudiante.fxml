<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="panelEstudiante" prefHeight="700.0"
	prefWidth="900.0" xmlns="http://javafx.com/javafx/25"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.alba.proyecto.controller.MenuEstudianteController">
	<top>
		<HBox fx:id="hbBarraSuperior" alignment="CENTER"
			fillHeight="false" prefHeight="98.0" prefWidth="900.0"
			BorderPane.alignment="CENTER">
			<children>
				<ImageView fitHeight="100.0" fitWidth="127.0"
					pickOnBounds="true" preserveRatio="true">
					<image>
						<Image url="@../images/LogoGestiona1_redondo.png" />
					</image>
				</ImageView>
				<Region prefHeight="150.0" prefWidth="350.0" />
				<VBox fx:id="vbUsuario" alignment="CENTER" prefHeight="150.0"
					prefWidth="216.0" spacing="20.0">
					<children>
						<Label fx:id="lblRol" text="Rol" />
						<Label fx:id="lblNombreUsuario" text="Nombre usuario" />
					</children>
				</VBox>
				<Button fx:id="btnLogOut" mnemonicParsing="false"
					prefHeight="36.0" prefWidth="85.0" text="Cerrar sesión" />
			</children>
			<padding>
				<Insets left="20.0" right="10.0" />
			</padding>
		</HBox>
	</top>
	<left>
		<VBox prefWidth="190.0" spacing="5.0"
			BorderPane.alignment="CENTER">
			<BorderPane.margin>
				<Insets left="10.0" right="10.0" />
			</BorderPane.margin>
			<children>
				<Button fx:id="btnMisDatos" mnemonicParsing="false"
					onAction="#abrirMisDatos" prefHeight="26.0" prefWidth="224.0"
					text="Mis datos" />
				<Button fx:id="btnMiFCT" mnemonicParsing="false"
					onAction="#abrirMiFCT" prefHeight="26.0" prefWidth="224.0"
					text="Mis FCTs" />
				<Button fx:id="btnAsistencia" mnemonicParsing="false"
					onAction="#abrirAsistencia" prefHeight="26.0" prefWidth="214.0"
					text="Asistencia" />
				<Button fx:id="btnDocumentacion" mnemonicParsing="false"
					onAction="#abrirDocumentacion" prefHeight="26.0" prefWidth="250.0"
					text="Documentación" />
			</children>
		</VBox>
	</left>
	<center>
		<StackPane prefHeight="150.0" prefWidth="200.0"
			BorderPane.alignment="CENTER">
			<children>
				<VBox fx:id="panelMisDatos" prefHeight="200.0"
					prefWidth="100.0" visible="false" managed="false" />
				<VBox fx:id="panelMisFCT" prefHeight="200.0" prefWidth="100.0"
					visible="false" managed="false" />

				<VBox fx:id="panelAsistencia" managed="false" prefHeight="600.0" prefWidth="700.0" visible="false" spacing="15.0">
					<padding>
						<Insets top="20.0" left="30.0" right="30.0" bottom="20.0" />
					</padding>
					<children>
						<Label text="Asistencia"
							style="-fx-font-size: 18px; -fx-font-weight: bold;" />
						<VBox fx:id="contenedorCalendario" prefHeight="400.0" prefWidth="650.0" />
						<HBox alignment="CENTER_LEFT" spacing="10.0">
							<children>
								<Label
									text="Faltas de asistencia pendientes de justificar:" />
								<Label fx:id="lblFaltasPendientes" text="0"
									style="-fx-font-weight: bold;" />
							</children>
						</HBox>
						<HBox alignment="CENTER_LEFT">
							<children>
								<Button fx:id="btnAdjuntarJustificante"
									mnemonicParsing="false" text="Adjuntar justificante" />
							</children>
						</HBox>
					</children>
				</VBox>
				<VBox fx:id="panelDocumentacion" prefHeight="200.0"
					prefWidth="100.0" visible="false" managed="false" />
			</children>
		</StackPane>
	</center>
</BorderPane>
