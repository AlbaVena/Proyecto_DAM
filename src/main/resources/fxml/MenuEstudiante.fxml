<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="panelEstudiante" prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alba.proyecto.controller.MenuEstudianteController">
   <top>
    <HBox fx:id="hbBarraSuperior" alignment="CENTER" fillHeight="false" prefHeight="98.0" prefWidth="900.0" BorderPane.alignment="CENTER">
        <children>
            <ImageView fitHeight="100.0" fitWidth="127.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../images/LogoGestiona1_redondo.png" />
                </image>
            </ImageView>
            <Region prefHeight="150.0" prefWidth="350.0" />
            <VBox fx:id="vbUsuario" alignment="CENTER" prefHeight="150.0" prefWidth="216.0" spacing="20.0">
                <children>
                    <Label fx:id="lblRol" text="Rol" />
                    <Label fx:id="lblNombreUsuario" text="Nombre usuario" />
                </children>
            </VBox>
            <Button fx:id="btnLogOut" mnemonicParsing="false" prefHeight="36.0" prefWidth="85.0" text="Cerrar sesión" />
        </children>
        <padding>
            <Insets left="20.0" right="10.0" />
        </padding>
    </HBox>
</top>
   <left>
      <VBox prefWidth="190.0" BorderPane.alignment="CENTER">
         <children>
            <TitledPane animated="false" text="untitled">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
              </content>
            </TitledPane>
         </children>
      </VBox>
   </left>
</BorderPane>
