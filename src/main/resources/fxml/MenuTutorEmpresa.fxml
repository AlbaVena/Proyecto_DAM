<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="panelTutor" prefHeight="700.0" prefWidth="900.0"
    stylesheets="@../styles/Styles.css" styleClass="fondo-principal"
    xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.alba.proyecto.controller.MenuTutorEmpresaController">

    <top>
        <HBox fx:id="hbBarraSuperior" styleClass="barra-superior"
            alignment="CENTER" fillHeight="false" prefHeight="98.0" prefWidth="900.0">
            <children>
                <ImageView fitHeight="100.0" fitWidth="127.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/LogoGestiona1_redondo.png" />
                    </image>
                </ImageView>
                <Region prefHeight="150.0" prefWidth="350.0" />
                <VBox alignment="CENTER" prefHeight="150.0" prefWidth="216.0" spacing="5.0">
                    <children>
                        <Label fx:id="lblRol" text="Rol" styleClass="label-rol" />
                        <Label fx:id="lblNombreUsuario" text="Nombre usuario" styleClass="label-nombre-usuario" />
                    </children>
                </VBox>
                <Button fx:id="btnLogOut" mnemonicParsing="false"
                    prefHeight="36.0" prefWidth="110.0" text="Cerrar sesión" styleClass="btn-logout">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Button>
                <Button fx:id="btnAyuda" mnemonicParsing="false"
					onAction="#abrirAyuda" prefHeight="30.0" prefWidth="30.0"
					styleClass="btn-ayuda" text="?">
					<HBox.margin>
						<Insets left="10.0" />
					</HBox.margin>
				</Button>
            </children>
            <padding>
                <Insets left="20.0" right="10.0" />
            </padding>
        </HBox>
    </top>

    <left>
        <VBox styleClass="fondo-menu" prefWidth="190.0" BorderPane.alignment="CENTER">
            <children>
                <TitledPane styleClass="titled-pane-menu" expanded="false" text="Tutorías">
                    <content>
                        <VBox styleClass="fondo-menu" prefWidth="190.0" spacing="2.0">
                            <children>
                                <Button fx:id="btnVerTutorias" styleClass="btn-menu"
                                    maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                    onAction="#abrirTutorias" text="Ver mis tutorías" />
                            </children>
                        </VBox>
                    </content>
                </TitledPane>
                <TitledPane styleClass="titled-pane-menu" expanded="false" text="Evaluación">
                    <content>
                        <VBox styleClass="fondo-menu" prefWidth="190.0" spacing="2.0">
                            <children>
                                <Button fx:id="btnNuevaEvaluacion" styleClass="btn-menu"
                                    maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                    onAction="#abrirNuevaEvaluacion" text="Nueva evaluación" />
                                <Button fx:id="btnConsultarEvaluaciones" styleClass="btn-menu"
                                    maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                    onAction="#abrirConsultarEvaluaciones" text="Consultar evaluaciones" />
                            </children>
                        </VBox>
                    </content>
                </TitledPane>
                <TitledPane styleClass="titled-pane-menu" expanded="false" text="Asistencia">
                    <content>
                        <VBox styleClass="fondo-menu" prefWidth="190.0" spacing="2.0">
                            <children>
                                <Button fx:id="btnRegistrarFalta" styleClass="btn-menu"
                                    maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                    onAction="#abrirRegistrarFalta" text="Registrar falta" />
                            </children>
                        </VBox>
                    </content>
                </TitledPane>
                <TitledPane styleClass="titled-pane-menu" expanded="false" text="Documentación">
                    <content>
                        <VBox styleClass="fondo-menu" prefWidth="190.0" spacing="2.0">
                            <children>
                                <Button fx:id="btnVerDocumentacion" styleClass="btn-menu"
                                    maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                    onAction="#abrirDocumentacion" text="Ver documentación" />
                            </children>
                        </VBox>
                    </content>
                </TitledPane>
            </children>
            <BorderPane.margin>
                <Insets left="10.0" right="10.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="stackPaneCentral" styleClass="fondo-principal"
            prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>

                <!-- Panel bienvenida -->
                <VBox fx:id="panelBienvenida" alignment="CENTER" spacing="20.0">
                    <children>
                        <ImageView fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/LogoGestiona1_redondo.png" />
                            </image>
                        </ImageView>
                        <Label fx:id="lblBienvenida" text="Bienvenido/a"
                            style="-fx-font-size: 22px; -fx-font-weight: bold;" />
                        <Label fx:id="lblSubtitulo" text="Tutor/a de Empresa"
                            style="-fx-font-size: 14px;" />
                    </children>
                </VBox>

                <!-- Panel tutorias -->
                <VBox fx:id="panelTutorias" managed="false" visible="false">
                    <children>
                        <Label text="Mis Tutorías" style="-fx-font-size: 18px; -fx-font-weight: bold;">
                            <VBox.margin><Insets top="20.0" left="30.0" /></VBox.margin>
                        </Label>
                    </children>
                </VBox>

                <!-- Panel nueva evaluacion -->
                <VBox fx:id="panelNuevaEvaluacion" managed="false" visible="false">
                    <children>
                        <Label text="Nueva Evaluación" style="-fx-font-size: 18px; -fx-font-weight: bold;">
                            <VBox.margin><Insets top="20.0" left="30.0" /></VBox.margin>
                        </Label>
                    </children>
                </VBox>

                <!-- Panel consultar evaluaciones -->
                <VBox fx:id="panelConsultarEvaluaciones" managed="false" visible="false">
                    <children>
                        <Label text="Consultar Evaluaciones" style="-fx-font-size: 18px; -fx-font-weight: bold;">
                            <VBox.margin><Insets top="20.0" left="30.0" /></VBox.margin>
                        </Label>
                    </children>
                </VBox>

                <!-- Panel registrar falta -->
                <VBox fx:id="panelRegistrarFalta" managed="false" visible="false">
                    <children>
                        <Label text="Registrar Falta" style="-fx-font-size: 18px; -fx-font-weight: bold;">
                            <VBox.margin><Insets top="20.0" left="30.0" /></VBox.margin>
                        </Label>
                    </children>
                </VBox>

                <!-- Panel documentacion -->
                <VBox fx:id="panelDocumentacion" managed="false" visible="false">
                    <children>
                        <Label text="Documentación" style="-fx-font-size: 18px; -fx-font-weight: bold;">
                            <VBox.margin><Insets top="20.0" left="30.0" /></VBox.margin>
                        </Label>
                    </children>
                </VBox>

            </children>
        </StackPane>
    </center>

    <padding>
        <Insets bottom="20.0" left="10.0" right="10.0" top="10.0" />
    </padding>

</BorderPane>