<?xml version="1.0" encoding="UTF-8"?>

<?import componentes.PasswordFieldValidado?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<StackPane
    prefHeight="700.0" prefWidth="900.0"
    styleClass="fondo-principal"
    stylesheets="@../styles/Styles.css"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.alba.proyecto.controller.LoginController">


    <VBox alignment="CENTER" spacing="16.0" maxWidth="320.0">

        <!-- Logo -->
        <ImageView fitHeight="110.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/LogoGestiona1_redondo.png" />
            </image>
        </ImageView>


        <Label text="Inicio de sesión" styleClass="titulo-panel">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <TextField fx:id="username" prefHeight="36.0" prefWidth="280.0" promptText="Usuario..." />

        <PasswordFieldValidado fx:id="password" prefHeight="36.0" prefWidth="280.0" promptText="Contraseña..." />

        <Label fx:id="lblError" text="Usuario o contraseña incorrectos."
               style="-fx-text-fill: #c0392b; -fx-font-size: 12px;"
               visible="false" managed="false" />

        <Button fx:id="btnLogin" prefHeight="36.0" prefWidth="280.0"
                styleClass="btn-primario" text="Iniciar sesión" mnemonicParsing="false" />

        <Hyperlink fx:id="lblOlvido" text="¿Olvidaste tu contraseña?"
                   style="-fx-font-size: 12px;" />

    </VBox>
</StackPane>
